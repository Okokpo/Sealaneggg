-- SETTINGS
--==================================================

local AntiHitEnabled = false
local FastPickupEnabled = false
local Running = false

--==================================================
-- TELEPORT POINTS
--==================================================

local Origin = Vector3.new(500, 70, -360)

local Offsets = {
    { 0.62, 171.28, -6.64 },
    { 4.45,  85.80, -6.35 },
    { 8.30,   0.28, -6.03 },
    {13.86,   0.28, -6.25 },
    {19.43,   0.28, -6.47 },
    {24.32,   0.28, -6.59 },
    {29.22,   0.28, -6.71 },
    {38.01,   0.28, -5.55 },
    {46.80,   0.28, -4.40},
}

local TeleportPoints = {}

for _, Offset in ipairs(Offsets) do
    TeleportPoints[#TeleportPoints + 1] =
        Origin + Vector3.new(
            Offset[1],
            Offset[2],
            Offset[3]
        )
end

