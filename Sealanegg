    FastPickupEnabled = not FastPickupEnabled

    if FastPickupEnabled then
        PickupToggle.Text = "FAST PICKUP: ON"
        PickupToggle.BackgroundColor3 = Color3.fromRGB(40, 170, 70)
    else
        PickupToggle.Text = "FAST PICKUP: OFF"
        PickupToggle.BackgroundColor3 = Color3.fromRGB(170, 40, 40)
