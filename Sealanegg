    Frame.Visible = false
    MiniButton.Visible = true

end)

--==================================================
-- SHOW GUI
--==================================================

MiniButton.Activated:Connect(function()

    Frame.Visible = true
    MiniButton.Visible = false

end)

--==================================================
-- ANTI-HIT
--==================================================

ProximityPromptService.PromptTriggered:Connect(function(
    prompt,
    playerWhoTriggered
)

    if not AntiHitEnabled then
        return
    end

    if playerWhoTriggered ~= Player then
        return
    end

    if Running then
        return
    end

    Running = true

    local CurrentCharacter = Player.Character

    if not CurrentCharacter then
        Running = false
        return
    end

    local Root = CurrentCharacter:FindFirstChild("HumanoidRootPart")

    if not Root then
        Running = false
        return
    end

    for _, Position in ipairs(TeleportPoints) do

        if not AntiHitEnabled then
            break
        end

        if not Root.Parent then
            break
        end

        Root.CFrame = CFrame.new(Position)

        task.wait(0.005)
    end

    Running = false

end)
