end)

--==================================================
-- FAST PICKUP
--==================================================

ProximityPromptService.PromptShown:Connect(function(prompt)

    if not FastPickupEnabled then
        return
    end

    -- Chỉ thay đổi prompt trong game của bạn
    prompt.HoldDuration = 0
end)

--==================================================
-- HIDE GUI
--==================================================

